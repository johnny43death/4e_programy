    <StackPanel Margin="20">
        <TextBlock x:Name="textBlock" Text="Kto mieczem wojuje ten sam w nie wpada"/>
        <WrapPanel>
            <TextBlock Text="20"/>
            <Slider x:Name="slider" Width="220" Minimum="20" Maximum="100" ValueChanged="slider_ValueChanged"/>
            <TextBlock Text="100"/>
        </WrapPanel>
        <WrapPanel>
            <Button Margin="5" x:Name="red"  Width="50" Height="25" Content="RED" Background="Red" Click="Red_Click"/>
            <Button Margin="5" x:Name="green" Width="50" Height="25" Content="GREEN" Background="Green" Click="Green_Click"/>
            <Button Margin="5" x:Name="blue" Width="50" Height="25" Content="BLUE" Background="Blue" Click="Blue_Click"/>
            <Button Margin="5" x:Name="yellow" Width="50" Height="25" Content="YELLOW" Background="Yellow" Click="Yellow_Click"/>
        </WrapPanel>
    </StackPanel>

